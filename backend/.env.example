DATABASE_URL=sqlite:///./fact_check.db
GOOGLE_FACT_CHECK_API_KEY =

# Feedback pedagógico via Ollama local (sem cobrança por chamada).
# Ollama exige um valor de API key no formato OpenAI-compatible, mas o ignora localmente.
FEEDBACK_LLM_API_KEY=ollama
FEEDBACK_LLM_BASE_URL=http://localhost:11434/v1
FEEDBACK_LLM_MODEL=qwen3:8b
FEEDBACK_LLM_TIMEOUT_SECONDS=8
FEEDBACK_LLM_MIN_ATTEMPTS=4
